# Bot tokeni — @BotFather'dan oling
BOT_TOKEN=your_bot_token_here

# Birinchi adminning Telegram ID'si
INITIAL_ADMIN_ID=123456789

# === RENDER UCHUN ===
# Public URL (Render avtomatik beradi, masalan: https://attendance-bot.onrender.com)
PUBLIC_URL=

# Ofis chiqish IP'lari (vergul bilan ajratilgan, telefon ofis WiFi'da turganda
# https://api.ipify.org sahifasidan oling)
OFFICE_PUBLIC_IPS=213.230.74.56

# === WEB DASHBOARD ===
# Maxfiy kalit — bo'sh qoldirilsa dashboard butunlay o'chiq bo'ladi.
# Kuchli kalit yaratish: openssl rand -hex 24
DASHBOARD_API_KEY=

# CORS: sfatshop web sahifasi API'ni fetch qilishi uchun origin
# (masalan https://api.sfatshop.uz). Bo'sh = CORS header qo'yilmaydi.
DASHBOARD_ALLOWED_ORIGIN=

# === IXTIYORIY ===
# Yuz tanish qattiqligi: 0.0 (qattiq) - 1.0 (yumshoq)
FACE_TOLERANCE=0.50

# Persistent disk yo'li (Render'da /data/attendance.db, local'da bo'sh qoldiring)
DB_PATH=/data/attendance.db
